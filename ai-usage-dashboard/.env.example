# ---- Server ----
PORT=8787
# Encrypts API keys stored via the Settings page (AES-256-GCM). If unset, a keyfile is auto-generated in ./data/.master.key
MASTER_KEY=change-me-to-a-long-random-string
# First-run admin bootstrap (alternative to creating account in the browser on first visit)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Provider keys can be supplied via env instead of the Settings UI (server-side only)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: OpenAI business/member account id for org endpoints
OPENAI_BIZ_MEMBER=
# Automatic sync interval in minutes (min 5)
SYNC_INTERVAL_MINUTES=60
# Optional webhook that receives alert JSON payloads
ALERT_WEBHOOK_URL=
# Run a sync shortly after startup
STARTUP_SYNC=0
# DEV ONLY — disables dashboard authentication. Never use in production!
AUTH_DISABLED=0
# Set to 1 behind HTTPS reverse proxy to mark session cookies Secure
COOKIE_SECURE=0
DATABASE_FILE=
DATA_DIR=
